APP_ENV=local
APP_NAME=TrainHub
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8009

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/trainhub_db
DATABASE_SSL=false
REDIS_URL=redis://127.0.0.1:6379/0

# Auth token lifetimes — change here, restart backend
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=14

STORAGE_BACKEND=local
MEDIA_DIR=media
PUBLIC_BASE_URL=http://127.0.0.1:8009

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1

APP_ORIGINS=http://localhost:3000
ADMIN_ORIGINS=http://localhost:5173

# Dev seed only — never use in production
SEED_ADMIN_EMAIL=admin@trainhub.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin1
