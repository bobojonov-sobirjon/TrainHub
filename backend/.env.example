APP_ENV=local
APP_NAME=TrainHub
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8009

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/trainhub_db
DATABASE_SSL=false
REDIS_URL=redis://127.0.0.1:6379/0

# Auth token lifetimes — change here, restart backend
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=14

STORAGE_BACKEND=local
MEDIA_DIR=media
PUBLIC_BASE_URL=http://127.0.0.1:8009

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1

APP_ORIGINS=http://localhost:3000
ADMIN_ORIGINS=http://localhost:5173

# Dev seed only — never use in production
SEED_ADMIN_EMAIL=admin@trainhub.local
SEED_ADMIN_PASSWORD=ChangeMeAdmin1

# Native Google / Apple (fallback, if token is not Firebase)
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_IDS=

# Firebase Admin — Google/Apple Auth + FCM push
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_GATEWAY_TOKEN=
SMS_ESKIZ_EMAIL=
SMS_ESKIZ_PASSWORD=
SMS_ESKIZ_FROM=4546
